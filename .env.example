# Copy to .env (gitignored) or export these in the shell.
# Never commit real keys. Restrict the Google key to the Street View Static API.

# Required only for Street View. The address screen still runs without it.
# Read from the environment, then ~/claude/.env, then ./.env.
GOOGLE_MAPS_API_KEY=

# Optional. Monthly image ledger. Default: ~/claude/google-usage.json
# GOOGLE_USAGE_PATH=

# Optional. Port for `npm start`. Default: 4173
# PORT=
